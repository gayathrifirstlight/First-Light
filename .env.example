# Copy this file to .env.local and fill in the values.

# Supabase (sign-up/login + database). Find these in your Supabase project:
# Project Settings → API (or "Connect" → App frameworks → Next.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Claude API key for AI column suggestions (https://console.anthropic.com → API keys).
# Optional: without it, the import still works using simple keyword rules.
ANTHROPIC_API_KEY=
